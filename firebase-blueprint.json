{
  "entities": {
    "AdminGrant": {
      "title": "AdminGrant",
      "description": "Server-controlled administrator authorization record.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "grantedBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Set via FieldValue.serverTimestamp()" }
      },
      "required": ["userId", "email", "displayName", "grantedBy", "createdAt"]
    },
    "UsernameReservation": {
      "title": "UsernameReservation",
      "description": "Unique lowercase username reservation record.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "username": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Set via FieldValue.serverTimestamp()" }
      },
      "required": ["userId", "username", "createdAt"]
    },
    "UserPrivateProfile": {
      "title": "UserPrivateProfile",
      "description": "Private user account record containing PII, role, and moderation status.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "fullName": { "type": "string" },
        "username": { "type": "string" },
        "email": { "type": "string" },
        "dateOfBirth": { "type": "string" },
        "gender": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "bio": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "status": { "type": "string", "enum": ["active", "suspended", "banned"] },
        "termsAccepted": { "type": "boolean" },
        "rememberMe": { "type": "boolean" },
        "emailVerified": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "lastActiveAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "fullName", "username", "email", "dateOfBirth", "role", "status", "termsAccepted", "createdAt", "updatedAt"]
    },
    "PublicProfile": {
      "title": "PublicProfile",
      "description": "Public social and dating profile without private PII.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "fullName": { "type": "string" },
        "username": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "bio": { "type": "string" },
        "gender": { "type": "string" },
        "ageGroup": { "type": "integer" },
        "interests": { "type": "array" },
        "lookingFor": { "type": "string" },
        "accountStatus": { "type": "string", "enum": ["active", "suspended", "banned"] },
        "followersCount": { "type": "integer" },
        "followingCount": { "type": "integer" },
        "postsCount": { "type": "integer" },
        "isVerified": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "fullName", "username", "accountStatus", "followersCount", "followingCount", "postsCount", "isVerified", "createdAt", "updatedAt"]
    },
    "Post": {
      "title": "Post",
      "description": "Social feed photo, video/reel, or text post.",
      "type": "object",
      "properties": {
        "authorId": { "type": "string" },
        "authorUsername": { "type": "string" },
        "authorName": { "type": "string" },
        "authorAvatar": { "type": "string" },
        "mediaType": { "type": "string", "enum": ["photo", "video", "text"] },
        "mediaData": { "type": "string" },
        "caption": { "type": "string" },
        "location": { "type": "string" },
        "likesCount": { "type": "integer" },
        "commentsCount": { "type": "integer" },
        "isReel": { "type": "boolean" },
        "status": { "type": "string", "enum": ["active", "removed"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorId", "authorUsername", "authorName", "mediaType", "caption", "likesCount", "commentsCount", "isReel", "status", "createdAt", "updatedAt"]
    },
    "PostLike": {
      "title": "PostLike",
      "description": "User like on a post.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "createdAt"]
    },
    "PostBookmark": {
      "title": "PostBookmark",
      "description": "User bookmark on a post.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "postId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "postId", "createdAt"]
    },
    "Comment": {
      "title": "Comment",
      "description": "Comment on a post or reel.",
      "type": "object",
      "properties": {
        "postId": { "type": "string" },
        "authorId": { "type": "string" },
        "authorUsername": { "type": "string" },
        "authorAvatar": { "type": "string" },
        "text": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "removed"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["postId", "authorId", "authorUsername", "text", "status", "createdAt", "updatedAt"]
    },
    "Story": {
      "title": "Story",
      "description": "Ephemeral social story.",
      "type": "object",
      "properties": {
        "authorId": { "type": "string" },
        "authorUsername": { "type": "string" },
        "authorName": { "type": "string" },
        "authorAvatar": { "type": "string" },
        "mediaData": { "type": "string" },
        "caption": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "removed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorId", "authorUsername", "authorName", "caption", "status", "createdAt"]
    },
    "Follow": {
      "title": "Follow",
      "description": "Directed follow relationship.",
      "type": "object",
      "properties": {
        "followerId": { "type": "string" },
        "targetId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["followerId", "targetId", "createdAt"]
    },
    "Swipe": {
      "title": "Swipe",
      "description": "Dating discovery action.",
      "type": "object",
      "properties": {
        "fromUserId": { "type": "string" },
        "toUserId": { "type": "string" },
        "action": { "type": "string", "enum": ["like", "pass", "super_spark"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["fromUserId", "toUserId", "action", "createdAt"]
    },
    "Match": {
      "title": "Match",
      "description": "Mutual dating match.",
      "type": "object",
      "properties": {
        "user1Id": { "type": "string" },
        "user2Id": { "type": "string" },
        "participantIds": { "type": "array" },
        "lastMessage": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["user1Id", "user2Id", "participantIds", "createdAt", "updatedAt"]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Direct messaging thread between two users.",
      "type": "object",
      "properties": {
        "participantIds": { "type": "array" },
        "lastMessage": { "type": "string" },
        "messageCount": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["participantIds", "messageCount", "createdAt", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Individual message inside a conversation.",
      "type": "object",
      "properties": {
        "senderId": { "type": "string" },
        "recipientId": { "type": "string" },
        "participantIds": { "type": "array" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["senderId", "recipientId", "participantIds", "text", "createdAt"]
    },
    "Report": {
      "title": "Report",
      "description": "User-submitted safety or content moderation report.",
      "type": "object",
      "properties": {
        "reporterId": { "type": "string" },
        "targetType": { "type": "string", "enum": ["user", "post", "reel", "comment", "story"] },
        "targetId": { "type": "string" },
        "targetParentId": { "type": "string" },
        "targetAuthorId": { "type": "string" },
        "reason": { "type": "string" },
        "details": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "resolved", "dismissed"] },
        "resolutionNote": { "type": "string" },
        "resolvedBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["reporterId", "targetType", "targetId", "reason", "status", "createdAt", "updatedAt"]
    },
    "AdminLog": {
      "title": "AdminLog",
      "description": "Immutable audit trail for administrator moderation and role actions.",
      "type": "object",
      "properties": {
        "adminId": { "type": "string" },
        "adminEmail": { "type": "string" },
        "action": { "type": "string" },
        "targetType": { "type": "string" },
        "targetId": { "type": "string" },
        "details": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["adminId", "adminEmail", "action", "targetType", "targetId", "details", "createdAt"]
    }
  },
  "firestore": {
    "/admins/{userId}": {
      "schema": { "$ref": "#/entities/AdminGrant" },
      "description": "Authoritative server-controlled admin role registry."
    },
    "/usernames/{usernameLower}": {
      "schema": { "$ref": "#/entities/UsernameReservation" },
      "description": "Unique lowercase username lock documents."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPrivateProfile" },
      "description": "Private user account documents including PII, role, and account status."
    },
    "/public_profiles/{userId}": {
      "schema": { "$ref": "#/entities/PublicProfile" },
      "description": "Public social and dating profile metadata."
    },
    "/posts/{postId}": {
      "schema": { "$ref": "#/entities/Post" },
      "description": "User posts and reels."
    },
    "/posts/{postId}/likes/{userId}": {
      "schema": { "$ref": "#/entities/PostLike" },
      "description": "Post like records."
    },
    "/posts/{postId}/bookmarks/{userId}": {
      "schema": { "$ref": "#/entities/PostBookmark" },
      "description": "User post bookmarks."
    },
    "/posts/{postId}/comments/{commentId}": {
      "schema": { "$ref": "#/entities/Comment" },
      "description": "Post comments."
    },
    "/stories/{storyId}": {
      "schema": { "$ref": "#/entities/Story" },
      "description": "User stories."
    },
    "/follows/{followId}": {
      "schema": { "$ref": "#/entities/Follow" },
      "description": "Follower-to-following edges."
    },
    "/swipes/{swipeId}": {
      "schema": { "$ref": "#/entities/Swipe" },
      "description": "Dating discovery swipes."
    },
    "/matches/{matchId}": {
      "schema": { "$ref": "#/entities/Match" },
      "description": "Mutual dating matches."
    },
    "/conversations/{convId}": {
      "schema": { "$ref": "#/entities/Conversation" },
      "description": "Direct message conversation headers."
    },
    "/conversations/{convId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Messages inside a conversation."
    },
    "/reports/{reportId}": {
      "schema": { "$ref": "#/entities/Report" },
      "description": "Content and user safety reports."
    },
    "/admin_logs/{logId}": {
      "schema": { "$ref": "#/entities/AdminLog" },
      "description": "Immutable administrator activity and moderation history logs."
    }
  }
}
